# D-ID API Key for video avatar generation
# Format: Basic YXV0... (include "Basic " prefix)
# Get from: https://studio.d-id.com/account-settings
DID_API_KEY=Basic_your_d_id_api_key_here

# OpenAI API Key (for local development only - use Render environment variables in production)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here
